[
  {
    "name": "history_with_multi_tool_calls_openai_shape",
    "request": {
      "model": "${MODEL}",
      "stream": false,
      "messages": [
        {"role": "user", "content": "先查上海天气和汇率"},
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "call_weather",
              "type": "function",
              "function": {
                "name": "get_weather",
                "arguments": "{\"city\":\"Shanghai\"}"
              }
            },
            {
              "id": "call_fx",
              "type": "function",
              "function": {
                "name": "get_fx_rate",
                "arguments": "{\"base\":\"USD\",\"quote\":\"CNY\"}"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_weather",
          "content": "{\"temp\":25,\"condition\":\"sunny\"}"
        },
        {
          "role": "tool",
          "tool_call_id": "call_fx",
          "content": "{\"rate\":7.2}"
        },
        {"role": "user", "content": "总结一下结果"}
      ]
    },
    "expect": {
      "stream": false,
      "tool_call": false
    }
  },
  {
    "name": "history_with_multi_function_calls_legacy_shape",
    "request": {
      "model": "${MODEL}",
      "stream": false,
      "messages": [
        {"role": "user", "content": "先查上海天气和汇率"},
        {
          "role": "assistant",
          "content": "",
          "function_call": {
            "name": "get_weather",
            "arguments": "{\"city\":\"Shanghai\"}",
            "id": "legacy_call_weather"
          }
        },
        {
          "role": "function",
          "name": "get_weather",
          "content": "{\"temp\":25,\"condition\":\"sunny\"}"
        },
        {
          "role": "assistant",
          "content": "",
          "function_call": {
            "name": "get_fx_rate",
            "arguments": "{\"base\":\"USD\",\"quote\":\"CNY\"}",
            "id": "legacy_call_fx"
          }
        },
        {
          "role": "function",
          "name": "get_fx_rate",
          "content": "{\"rate\":7.2}"
        },
        {"role": "user", "content": "总结一下结果"}
      ]
    },
    "expect": {
      "stream": false,
      "tool_call": false
    }
  }
]
