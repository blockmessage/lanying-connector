[
  {
    "name": "vendor_old_functions_forced_tool",
    "request": {
      "model": "${MODEL}",
      "stream": false,
      "messages": [
        {
          "role": "user",
          "content": "请调用 get_weather，城市是 Shanghai"
        }
      ],
      "functions": [
        {
          "name": "get_weather",
          "description": "Get weather",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      ],
      "function_call": {
        "name": "get_weather"
      }
    },
    "expect": {
      "stream": false,
      "tool_call": true
    }
  },
  {
    "name": "vendor_new_tools_stream_forced_tool",
    "request": {
      "model": "${MODEL}",
      "stream": true,
      "messages": [
        {
          "role": "user",
          "content": "Please call get_weather for Shanghai"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "Get weather",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "function": {
          "name": "get_weather"
        }
      }
    },
    "expect": {
      "stream": true,
      "tool_call": true
    }
  },
  {
    "name": "vendor_content_list_mixed",
