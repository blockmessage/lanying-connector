FLASK_APP=lanying_connector
FLASK_DEBUG=true
LANYING_USER_ID=
LANYING_ADMIN_TOKEN=
LANYING_API_ENDPOINT=https://s-1-3-api.maximtop.cn
LANYING_CONNECTOR_SERVICE=openai
LANYING_CONNECTOR_REDIS_SERVER=redis://:@redis:6379/0
SEENICAL_PUBLIC_SKILL_REPOSITORY_URL=https://github.com/maxim-top/seenical-skills
SEENICAL_PUBLIC_SKILL_REPOSITORY_REF=main
SEENICAL_PUBLIC_SKILL_MANIFEST_PATH=.seenical/manifest.json
LANYING_AGENT_TOOLS_PLATFORM_ENABLED=off
LANYING_AGENT_TOOLS_ENABLED=off
LANYING_AGENT_TOOLS_MYSQL_HOST=
LANYING_AGENT_TOOLS_MYSQL_PORT=3306
LANYING_AGENT_TOOLS_MYSQL_DBNAME=seenical_agent_tools
LANYING_AGENT_TOOLS_MYSQL_USER=seenical
LANYING_AGENT_TOOLS_MYSQL_PASSWORD=
LANYING_AGENT_TOOLS_MYSQL_POOL_SIZE=5
LANYING_AGENT_TOOLS_MYSQL_MAX_OVERFLOW=10
LANYING_AGENT_TOOLS_MYSQL_POOL_RECYCLE_SECONDS=1800
LANYING_AGENT_TOOLS_MYSQL_CONNECT_TIMEOUT_SECONDS=10
LANYING_AGENT_TOOLS_MYSQL_READ_TIMEOUT_SECONDS=10
LANYING_AGENT_TOOLS_MYSQL_WRITE_TIMEOUT_SECONDS=10
